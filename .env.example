## ─────────────────────────────────────────────────────────────── database ──
# Neon Postgres. Use the *pooled* connection string for the app.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/treax?sslmode=require"
# Direct (unpooled) URL — only needed if you run migrations against Neon.
# DIRECT_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/treax?sslmode=require"

## ─────────────────────────────────────────────────────────────────── auth ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Only needed if the deployment URL cannot be inferred (most Vercel setups can).
# AUTH_URL="https://treax.vercel.app"
# Enables the university-SSO provider in production. Leave unset to disable it.
# UNIVERSITY_SSO_SECRET=""

## ────────────────────────────────────────────────────────────────── ai (Groq) ──
# https://console.groq.com/keys — server-side only, never exposed to the client.
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

## ──────────────────────────────────────────────────── image storage (Cloudinary) ──
# https://console.cloudinary.com — Dashboard → API keys
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

## ───────────────────────────────────────────────────────── realtime (Pusher) ──
# https://dashboard.pusher.com — Channels app → App Keys
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="ap2"
# The key and cluster are also needed client-side to open the socket.
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="ap2"

## ─────────────────────────────────────────────────────────────────── seed ──
# Password given to every seeded demo account.
SEED_PASSWORD="treax1234"
